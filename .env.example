# 이 파일을 .env로 복사해서 값을 채우세요. .env는 커밋되지 않습니다.
#
#   cp .env.example .env
#
# 배치 스크립트는 Node 네이티브 --env-file-if-exists로 .env를 읽습니다.
# GitHub Actions에서는 .env가 없어도 워크플로가 주입한 환경변수를 그대로 씁니다.

# ─── API 키 ───────────────────────────────────────────────

# 서울열린데이터광장 인증키 (무료·즉시 발급)
# https://data.seoul.go.kr → 로그인 → 인증키 신청
SEOUL_API_KEY=

# 비짓서울 API 키
# https://api.visitseoul.net
VISITSEOUL_API_KEY=

# ─── 수집 설정 ────────────────────────────────────────────

# 비짓서울에서 수집할 카테고리 (com_ctgry_sn, 쉼표 구분)
# Task 0 실측 기준 (docs/api-findings.md 참조):
#   Cv7s8m5  축제/공연/행사  1,188건
#   Ca0o2d4  문화관광          733건
#   Ca1z6p7  역사               88건
#   Co6c2n2  자연               68건
# 합계 약 2,077건 = hydrate 초회 호출 수.
# 음식(1,267)·쇼핑(298)·숙박(17)은 이 앱의 목적에 맞지 않아 제외했습니다.
VISITSEOUL_CATEGORIES=Cv7s8m5,Ca0o2d4,Ca1z6p7,Co6c2n2

# ─── LLM ──────────────────────────────────────────────────

# ollama = 로컬 개발 / rule = LLM 없이 규칙 상위 사용 (GitHub Actions)
# Actions 러너에서는 Ollama가 돌지 않으므로 rule로 동작합니다.
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
